{
  "name": "report-frontend",
  "version": "1.0.0",
  "description": "研究生周报助手 V1.0 前端",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:desktop": "cross-env VITE_PLATFORM=desktop VITE_API_BASE=https://qianqian-08c14.containers.snapdeploy.app/api vite build",
    "electron:dev": "electron .",
    "dist:win": "npm run build:desktop && electron-builder --win --x64"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "axios": "^1.7.2",
    "element-plus": "^2.7.5",
    "pinia": "^2.1.7",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^5.2.11"
  },
  "build": {
    "appId": "com.report.assistant",
    "productName": "ReportAssistant",
    "executableName": "ReportAssistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*",
      "!android/**/*",
      "!capacitor.config.ts"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "研究生周报助手-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "研究生周报助手"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true
  }
}
